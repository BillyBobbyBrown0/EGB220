#include <Arduino.h>
#include <Encoder.h>

// ===== SENSORS =====
#define N_SENS 8
uint8_t sens[N_SENS] = {0, 1, 2, 3, 4, 5, 6, 7};
uint16_t sens_out[N_SENS];
int threshold = 150;

// ===== MOTORS =====
#define MOTOR_A_PWM 11
#define MOTOR_A_DIR 17
#define MOTOR_B_PWM 3
#define MOTOR_B_DIR 7

// ===== ENCODER =====
#define ENCODER_A_PIN 0
#define ENCODER_B_PIN 1
#define COUNTS_PER_ROTATION (12 * 50)
Encoder encoderA(ENCODER_A_PIN, ENCODER_B_PIN);

// ===== SPEED PID =====
const double Kp_speed = 5.0;
const double Ki_speed = 1.0;
const double Kd_speed = 4.0;
double target_speed = 0.1;  // rotations/sec — tune this

// ===== LINE PD =====
int Kp_line = 60;
int Kd_line = 25;
int weights[N_SENS] = {-7, -5, -3, -1, 1, 3, 5, 7};

// ===== SPEED LIMITS =====
int maxSpeed = 200;
int minSpeed = 60;
int baseSpeed = 100;  // target base PWM before PID adjustment

// ===== STATE =====
int lastLineError = 0;
double ei_speed = 0.0;
double prev_ep_speed = 0.0;
double pwm_base = 100.0;  // speed PID output — feeds into both motors
double prev_position = 0.0;
unsigned long prev_time = 0;

bool isBlack(uint16_t val) {
  return val < threshold;
}

uint16_t readADC(uint8_t ch) {
  ADCSRB &= ~(1 << MUX5);
  ADMUX = (1 << REFS0) | (ch & 0x07);
  ADCSRA |= (1 << ADSC);
  while (ADCSRA & (1 << ADSC));
  return ADC;
}

void setup() {
  Serial.begin(9600);

  pinMode(MOTOR_A_PWM, OUTPUT);
  pinMode(MOTOR_A_DIR, OUTPUT);
  pinMode(MOTOR_B_PWM, OUTPUT);
  pinMode(MOTOR_B_DIR, OUTPUT);

  digitalWrite(MOTOR_A_DIR, HIGH);
  digitalWrite(MOTOR_B_DIR, HIGH);

  ADMUX  = (1 << REFS0);
  ADCSRA = (1 << ADEN) | (1 << ADPS2) | (1 << ADPS1) | (1 << ADPS0);

  prev_time = micros();
}

void loop() {

  unsigned long current_time = micros();
  double dt = (current_time - prev_time) / 1000000.0;
  prev_time = current_time;

  double current_position = encoderA.read() / (double)COUNTS_PER_ROTATION;
  double current_speed = (current_position - prev_position) / dt;
  prev_position = current_position;

  double ep = target_speed - current_speed;
  double ed = (ep - prev_ep_speed) / dt;
  ei_speed += ep * dt;
  ei_speed = constrain(ei_speed, -10.0, 10.0);

  pwm_base += (Kp_speed * ep) + (Ki_speed * ei_speed) + (Kd_speed * ed);
  pwm_base  = constrain(pwm_base, minSpeed, maxSpeed);

  prev_ep_speed = ep;

  for (int i = 0; i < N_SENS; i++) {
    sens_out[i] = readADC(sens[i]);
  }

  int lineError = 0;
  int count = 0;

  for (int i = 0; i < N_SENS; i++) {
    if (isBlack(sens_out[i])) {
      lineError += weights[i];
      count++;
    }
  }

  int steerCorrection = 0;

  if (count == 0) {
    // Lost the line — drive straight and hope to reacquire
    steerCorrection = 0;
  } else {
    lineError /= count;
    int derivative  = lineError - lastLineError;
    steerCorrection = (Kp_line * lineError) + (Kd_line * derivative);
    steerCorrection = constrain(steerCorrection, -120, 120);
    lastLineError   = lineError;
  }

  // Speed PID sets the base, line PD steers around it
  int leftSpeed  = (int)pwm_base - steerCorrection;
  int rightSpeed = (int)pwm_base + steerCorrection;

  leftSpeed  = constrain(leftSpeed,  minSpeed, maxSpeed);
  rightSpeed = constrain(rightSpeed, minSpeed, maxSpeed);

  analogWrite(MOTOR_A_PWM, leftSpeed);
  analogWrite(MOTOR_B_PWM, rightSpeed);

  Serial.print("spd:"); Serial.print(current_speed, 3);
  Serial.print(" pwm_base:"); Serial.print(pwm_base);
  Serial.print(" steer:"); Serial.print(steerCorrection);
  Serial.print(" L:"); Serial.print(leftSpeed);
  Serial.print(" R:"); Serial.print(rightSpeed);
  Serial.print(" | ");
  for (int i = 0; i < N_SENS; i++) {
    Serial.print(sens_out[i]); Serial.print(" ");
  }
  Serial.println();
}
